# AccessAI API (packages/api). Without a key the API answers in demo mode.
ANTHROPIC_API_KEY=
# Optional overrides. The launch doc asks for Sonnet for reasoning and Haiku for fast summaries.
ACCESSAI_REASONING_MODEL=claude-sonnet-5-5
ACCESSAI_FAST_MODEL=claude-haiku-5-5
# Force demo answers even when a key is set: ACCESSAI_BRAIN=demo
PORT=8787
